# EduFlow environment variables (copy to .env and fill in).
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Next.js app (src/)
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma at runtime and for migrations.
# Required for any DB-backed route. Example (local Docker Compose):
DATABASE_URL="postgresql://eduflow:eduflow@127.0.0.1:5432/eduflow"

# Netlify DB fallback — used only if DATABASE_URL is unset (see src/lib/prisma.ts).
# NETLIFY_DB_URL=""

# Set automatically by the platform in most cases; controls cookie `secure`
# flag, CSP/HSTS headers, and Prisma logging. Use "production" in prod.
# NODE_ENV="development"

# Transactional email. Without EMAIL_WEBHOOK_URL, emails are logged to the
# server console (dev). Set both to deliver real mail.
EMAIL_FROM="EduFlow <no-reply@eduflow.local>"
# EMAIL_WEBHOOK_URL="https://hooks.example.com/eduflow-email"

# ---------------------------------------------------------------------------
# AI service integration (Next.js BFF -> ai-service)
# ---------------------------------------------------------------------------

# Base URL the BFF uses to reach the Python ai-service.
AI_SERVICE_URL="http://ai-service:8000"

# Shared HS256 secret used to mint/verify the short-lived service token.
# MUST match ai-service AI_SERVICE_TOKEN_SECRET. Generate a strong random value.
AI_SERVICE_TOKEN_SECRET="change-me-in-every-environment"

# Token audience claim; must match ai-service AI_SERVICE_TOKEN_AUD.
AI_SERVICE_TOKEN_AUD="ai-service"

# Optional: upstream request timeout in ms (default 15000).
# AI_SERVICE_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Python ai-service (ai-service/) — see ai-service/app/core/config.py
# ---------------------------------------------------------------------------

# DATABASE_URL (SQLAlchemy form), REDIS_URL, OLLAMA_URL:
# DATABASE_URL="postgresql+psycopg://eduflow:eduflow@postgres:5432/eduflow"
# REDIS_URL="redis://redis:6379/0"
# OLLAMA_URL="http://ollama:11434"

# Models / provider:
# LLM_MODEL="llama3.1:8b"
# EMBED_MODEL="nomic-embed-text"
# WHISPER_MODEL="small"
# AI_PROVIDER="ollama"           # ollama | openai

# Service token (must match the app values above):
# AI_SERVICE_TOKEN_SECRET="change-me-in-every-environment"
# AI_SERVICE_TOKEN_AUD="ai-service"

# Limits / policy:
# MAX_AUDIO_MB="25"
# MAX_AUDIO_SECONDS="300"
# RATE_LIMIT_VOICE_PER_MIN="6"
# JOB_RESULT_TTL_SECONDS="86400"
# TRANSCRIPT_RETENTION_DAYS="30"
# MAX_QUESTION_CHARS="2000"
# AUDIO_DIR="/data/audio"
# ENVIRONMENT="development"
